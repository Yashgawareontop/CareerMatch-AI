# ─────────────────────────────────────────────────────────────
# CareerMatch AI — environment variables
# Copy to `.env.local` and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Convex (database) ────────────────────────────────────────
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ── AI provider ──────────────────────────────────────────────
# Primary provider: "groq" (default) | "gemini". The other one is the fallback.
AI_PROVIDER=groq

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (see https://aistudio.google.com/docs/models)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Reads scanned resumes (free, fast): https://aistudio.google.com/docs/models
GEMINI_OCR_MODEL=gemini-3.5-flash-lite

# Groq — free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# ── Resume parsing (Phase 2) ─────────────────────────────────
# Shared secret between this server and Convex. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and set the SAME value on Convex: npx convex env set RESUME_PARSER_SECRET <value>
RESUME_PARSER_SECRET=

# ── Job / internship sources (added in Phase 4) ──────────────
# Adzuna — https://developer.adzuna.com/ (free developer key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble — https://jooble.org/api/about (free key)
JOOBLE_API_KEY=
JOOBLE_LOCATION=India
# Remotive, Arbeitnow, RemoteOK, Himalayas: public, no key needed.
# Small Groq model that labels unclear listings (intern / entry / mid / senior)
GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b
# Secret header for POST /api/jobs/sync. Generate like RESUME_PARSER_SECRET.
# For the daily Convex cron, also set it (and the app's public URL) on Convex:
#   npx convex env set JOBS_SYNC_SECRET <value>
#   npx convex env set JOBS_SYNC_URL https://your-app.example.com
JOBS_SYNC_SECRET=

# ── Skills taxonomy (optional, Phase 3) ──────────────────────
# O*NET Web Services — https://services.onetcenter.org/ (free, attribution)
ONET_API_KEY=
# ESCO API needs no key: https://ec.europa.eu/esco/api

# ── Ops (Phase 7) ────────────────────────────────────────────
# Set on Convex, not here: Convex user ids (comma-separated) that may see
# service-wide AI usage on /usage.
#   npx convex env set ADMIN_USER_IDS <your user _id>
